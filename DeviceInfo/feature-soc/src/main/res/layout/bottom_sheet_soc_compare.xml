<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="#40888888"
        android:backgroundTint="#40888888"/>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ SoC Comparison"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"/>

    <!-- Your detected chip banner -->
    <TextView
        android:id="@+id/tvYourChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#FF7B2FBE"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvYourScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="#FF888888"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp"
        android:visibility="gone"/>

    <!-- Comparison Chart -->
    <com.example.deviceinfo.feature.soc.SocCompareChartView
        android:id="@+id/compareChart"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"/>

    <!-- Ref chip name & score below chart -->
    <TextView
        android:id="@+id/tvRefChipName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FF546E7A"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingBottom="2dp"/>

    <TextView
        android:id="@+id/tvRefChipScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textColor="#FF888888"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#18000000"
        android:layout_marginHorizontal="16dp"/>

    <!-- Search box -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:hint="Search chip…"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionSearch"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Maker filter chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupMaker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        app:singleSelection="true"
        app:selectionRequired="true"/>

    <!-- Tier filter chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        app:singleSelection="true"
        app:selectionRequired="true"/>

    <!-- Chip list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChips"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

</LinearLayout>
