<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#1500E5FF"
    app:cardBackgroundColor="#0B00E5FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:gravity="center_vertical">

        <!-- Star / source tab indicator bar -->
        <View
            android:id="@+id/accentBar"
            android:layout_width="3dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:background="#00E5FF"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Source tab badge -->
            <TextView
                android:id="@+id/tvTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOC"
                android:textSize="9sp"
                android:textColor="#8000E5FF"
                android:letterSpacing="0.10"
                android:textStyle="bold"
                android:paddingBottom="2dp"/>

            <TextView
                android:id="@+id/tvLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8B9AB5"
                android:textSize="13sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="end"
            android:paddingEnd="4dp"/>

        <!-- Unpin button -->
        <ImageView
            android:id="@+id/btnUnpin"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_star_filled"
            android:tint="#6600E5FF"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Unpin"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
