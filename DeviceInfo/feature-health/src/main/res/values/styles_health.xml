<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="HealthStatCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/bg_health_stat_card</item>
        <item name="android:layout_marginHorizontal">4dp</item>
    </style>

    <style name="HealthStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#00E5FF</item>
    </style>

    <style name="HealthStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#888888</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

</resources>
