<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Header card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0D1117">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡  BENCHMARK"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"/>

                <TextView
                    android:id="@+id/tvDeviceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#607080"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#8B9AB5"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="200dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:progressTint="#00E5FF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRun"
                    android:layout_width="160dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="▶  RUN BENCHMARK"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    app:backgroundTint="#00E5FF"
                    app:cornerRadius="22dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Total score gauge (large) -->
        <com.example.deviceinfo.feature.benchmark.ScoreGaugeView
            android:id="@+id/scoreGaugeTotal"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"/>

        <!-- Row: Single + Multi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.example.deviceinfo.feature.benchmark.ScoreGaugeView
                android:id="@+id/scoreGaugeSingle"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"/>

            <com.example.deviceinfo.feature.benchmark.ScoreGaugeView
                android:id="@+id/scoreGaugeMulti"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"/>

            <com.example.deviceinfo.feature.benchmark.ScoreGaugeView
                android:id="@+id/scoreGaugeMem"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <!-- Detail text -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0A0E1A">

            <TextView
                android:id="@+id/tvDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="#8B9AB5"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="Run benchmark to see detailed results."/>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
