<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingTop="4dp">

    <!-- Two gauges side by side: ST and MT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp">

        <com.example.deviceinfo.feature.benchmark.BenchmarkGaugeView
            android:id="@+id/stGauge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#22000000"
            android:layout_marginVertical="12dp"/>

        <com.example.deviceinfo.feature.benchmark.BenchmarkGaugeView
            android:id="@+id/mtGauge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

    </LinearLayout>

    <!-- Status text + progress bar -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap Run Benchmark to start"
        android:textColor="#FF78909C"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"/>

    <!-- History chart -->
    <com.example.deviceinfo.feature.benchmark.BenchmarkHistoryChartView
        android:id="@+id/historyChart"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"/>

    <!-- Run / Clear buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRunBenchmark"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="2"
            android:layout_marginEnd="8dp"
            android:text="Run Benchmark"
            android:textSize="13sp"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearHistory"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Clear"
            android:textSize="12sp"
            app:cornerRadius="12dp"/>

    </LinearLayout>

    <include
        android:id="@+id/searchBar"
        layout="@layout/layout_search_bar"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

</LinearLayout>
