<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingTop="4dp">

    <!-- Two CPU gauges: ST and MT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp">

        <com.example.deviceinfo.feature.benchmark.BenchmarkGaugeView
            android:id="@+id/stGauge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#22000000"
            android:layout_marginVertical="12dp"/>

        <com.example.deviceinfo.feature.benchmark.BenchmarkGaugeView
            android:id="@+id/mtGauge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

    </LinearLayout>

    <!-- Memory | Disk | Crypto mini cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <!-- Memory card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1A2196F3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💾 MEM"
                    android:textSize="9sp"
                    android:textColor="#882196F3"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tvMemWrite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="W: —"
                    android:textSize="11sp"
                    android:textColor="#FF2196F3"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvMemRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R: —"
                    android:textSize="11sp"
                    android:textColor="#BB2196F3"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Disk card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1AFF9800">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💿 DISK"
                    android:textSize="9sp"
                    android:textColor="#88FF9800"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tvDiskWrite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="W: —"
                    android:textSize="11sp"
                    android:textColor="#FFFF9800"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvDiskRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R: —"
                    android:textSize="11sp"
                    android:textColor="#BBFF9800"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Crypto card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1AE91E63">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔐 AES"
                    android:textSize="9sp"
                    android:textColor="#88E91E63"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tvCryptoMbps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— MB/s"
                    android:textSize="11sp"
                    android:textColor="#FFE91E63"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvCryptoClass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AES-256"
                    android:textSize="11sp"
                    android:textColor="#BBE91E63"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Status + progress -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap Run Benchmark to start"
        android:textColor="#FF78909C"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"/>

    <!-- History chart -->
    <com.example.deviceinfo.feature.benchmark.BenchmarkHistoryChartView
        android:id="@+id/historyChart"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"/>

    <!-- Run / Clear buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRunBenchmark"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="2"
            android:layout_marginEnd="8dp"
            android:text="Run Benchmark"
            android:textSize="13sp"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearHistory"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Clear"
            android:textSize="12sp"
            app:cornerRadius="12dp"/>

    </LinearLayout>

    <include
        android:id="@+id/searchBar"
        layout="@layout/layout_search_bar"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

</LinearLayout>
