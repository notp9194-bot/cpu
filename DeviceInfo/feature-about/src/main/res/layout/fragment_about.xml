<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Hero Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0D1117"
            app:strokeWidth="1dp"
            app:strokeColor="#1A00E5FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="28dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_chip_about"
                    android:tint="#00E5FF"
                    android:contentDescription="App Icon"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="CPU-A"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"/>

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Version 2.0"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Complete hardware &amp; software diagnostics for your Android device — all local, no data collected."
                    android:textColor="#8B9AB5"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.6"
                    android:gravity="center"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Features Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0D1117"
            app:strokeWidth="1dp"
            app:strokeColor="#1A607080">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FEATURES"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡  SOC — Processor, cores, clock speeds, GPU\n💾  Device — RAM, storage, screen, display\n🔧  System — Android version, kernel, uptime\n🔋  Battery — Level, health, current, voltage\n🌡️  Thermal — Real-time zone temperatures\n📡  Sensors — All hardware sensors list\n🌐  Network — WiFi, connection type, speed\n📸  Camera — Resolution, aperture, focal length\n🔊  Audio — Codecs, sample rate, mic info"
                    android:textColor="#C8D0DC"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.8"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Privacy Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0D1117"
            app:strokeWidth="1dp"
            app:strokeColor="#1A607080">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRIVACY"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CPU-A does not collect, store, or transmit any personal data. All information is read locally on your device only."
                    android:textColor="#8B9AB5"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.6"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15607080"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERMISSIONS USED"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• ACCESS_NETWORK_STATE — Check connection type\n• ACCESS_WIFI_STATE — Read WiFi details"
                    android:textColor="#8B9AB5"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.7"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Export Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportAll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="Export Full Report"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:backgroundTint="#00E5FF"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_share"
            app:iconTint="#000000"
            app:iconPadding="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportJson"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Export JSON"
            android:textColor="#00E5FF"
            app:strokeColor="#2200E5FF"
            app:cornerRadius="24dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exports all tabs to a single .txt file in your Downloads folder."
            android:textSize="11sp"
            android:textColor="#607080"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Made with ♥ for Android"
            android:textColor="#3A4A5A"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
