<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CPU-Z" android:textColor="#9B59B6" android:textSize="28sp"
            android:textStyle="bold" android:layout_marginTop="24dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="for Android" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/tvVersion" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Version 1.0"
            android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/tvDescription" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="CPUID CPU-Z is a free software."
            android:textColor="#FFFFFF" android:textSize="14sp"
            android:layout_marginTop="8dp" android:gravity="center"/>
        <Button android:id="@+id/btnOnlineValidation" android:layout_width="240dp"
            android:layout_height="44dp" android:layout_marginTop="32dp"
            android:text="ONLINE VALIDATION" android:textColor="#FFFFFF"
            android:backgroundTint="#9B59B6" android:textSize="13sp"/>
        <Button android:id="@+id/btnSettings" android:layout_width="240dp"
            android:layout_height="44dp" android:layout_marginTop="12dp"
            android:text="CPU-Z SETTINGS" android:textColor="#FFFFFF"
            android:backgroundTint="#9B59B6" android:textSize="13sp"/>
        <Button android:id="@+id/btnHelp" android:layout_width="240dp"
            android:layout_height="44dp" android:layout_marginTop="12dp"
            android:text="HELP AND FAQ" android:textColor="#FFFFFF"
            android:backgroundTint="#9B59B6" android:textSize="13sp"/>
        <Button android:id="@+id/btnRemoveAds" android:layout_width="240dp"
            android:layout_height="44dp" android:layout_marginTop="12dp"
            android:text="REMOVE ADS" android:textColor="#FFFFFF"
            android:backgroundTint="#9B59B6" android:textSize="13sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CPUID Web Page" android:textColor="#9B59B6"
            android:textSize="13sp" android:layout_marginTop="32dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Validation Web Page" android:textColor="#9B59B6"
            android:textSize="13sp" android:layout_marginTop="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Copyright © 2025 - CPUID - All Rights Reserved"
            android:textColor="#888888" android:textSize="11sp"
            android:layout_marginTop="8dp" android:gravity="center"/>
    </LinearLayout>
</ScrollView>
