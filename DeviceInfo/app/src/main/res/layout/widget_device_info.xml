<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CPU-A"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"/>

        <TextView
            android:id="@+id/widgetTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#607080"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Battery row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔋 Battery"
            android:textColor="#8B9AB5"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/widgetBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-%"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- CPU row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ CPU"
            android:textColor="#8B9AB5"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/widgetCpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- MHz"
            android:textColor="#7B2FBE"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- RAM row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💾 RAM"
            android:textColor="#8B9AB5"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/widgetRam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- MB free"
            android:textColor="#2196F3"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Storage row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📦 Storage"
            android:textColor="#8B9AB5"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/widgetStorage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- GB free"
            android:textColor="#69F0AE"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
