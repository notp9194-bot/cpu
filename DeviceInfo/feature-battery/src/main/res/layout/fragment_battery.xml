<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- Doughnut + Live chart row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp">

            <com.example.deviceinfo.feature.battery.BatteryDoughnutView
                android:id="@+id/batteryDoughnut"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>

            <com.example.deviceinfo.feature.battery.BatteryChartView
                android:id="@+id/batteryChart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"/>
        </LinearLayout>

        <!-- RAM line chart -->
        <com.example.deviceinfo.feature.battery.RamChartView
            android:id="@+id/ramChart"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginHorizontal="12dp"
            android:background="@android:color/transparent"/>

        <!-- Battery Wear Level + mAh Live Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔋 Battery Wear Level"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"/>

        <com.example.deviceinfo.feature.battery.BatteryWearGaugeView
            android:id="@+id/wearGauge"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="4dp"/>

        <!-- 24-Hour Battery History Chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="24H Battery History"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.7"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearHistory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Clear"
                android:textColor="#FF5252"
                android:textSize="10sp"
                app:strokeColor="#22FF5252"
                app:cornerRadius="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </LinearLayout>

        <com.example.deviceinfo.feature.battery.BatteryHistoryChartView
            android:id="@+id/batteryHistoryChart"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"/>

        <!-- Export button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Export"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                app:strokeColor="#2200E5FF"
                app:cornerRadius="10dp"/>
        </LinearLayout>

        <include
            android:id="@+id/searchBar"
            layout="@layout/layout_search_bar"/>

        <!-- FIX: wrap_content instead of 0dp + weight (inside NestedScrollView, weight doesn't work) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingBottom="16dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
